<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" PrivateAssets="true" Version="2.2.1" />
		<Publicize Include="tModLoader" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
		<Publicize Include="tModLoader;FNA" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Daybreak">
	    <HintPath>..\ModAssemblies\Daybreak_v2.1.0.dll</HintPath>
	  </Reference>
	  <Reference Include="ModLiquidLib">
	    <HintPath>..\ModAssemblies\ModLiquidLib_v2025.9.dll</HintPath>
	  </Reference>
	  <Reference Include="ShopExpander">
	    <HintPath>..\ModAssemblies\ShopExpander_v1.8.1.dll</HintPath>
	  </Reference>
	</ItemGroup>
	<ItemGroup>
		<!-- Add every asset as an additional file so that our source generator can find it -->
		<AdditionalFiles Include="Assets\**" />
		<PackageReference Include="ZourceGen" Version="1.1.5" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
	</ItemGroup>
	
	<!-- Global usings!!!!! -->
	<ItemGroup>
		<Using Include="Terraria.ModLoader.ModContent" Static="true" />
		<Using Include="System.MathF" Static="true" />
		<Using Include="Microsoft.Xna.Framework.MathHelper" Static="true" />
		<Using Include="Terraria.ModLoader" />
		<Using Include="Microsoft.Xna.Framework.Graphics" />
		<Using Include="Microsoft.Xna.Framework" />
		<Using Include="Terraria" />
		<Using Include="Terraria.ID" />
		<Using Include="Terraria.DataStructures" />
		<Using Include="Terraria.GameContent" />
	</ItemGroup>

	<ItemGroup Condition="'$(DesignTimeBuild)' != 'true'">
		<EffectFiles Include="**/*.fx" />
	</ItemGroup>
	<PropertyGroup>
		<FxcCompilerPath>./Assets/Effects/Compiler/fxc.exe</FxcCompilerPath>
	</PropertyGroup>
	<Target Name="BuildEffects" BeforeTargets="BuildMod" Condition="$([MSBuild]::IsOSPlatform('Windows'))" Inputs="@(EffectFiles->'%(RecursiveDir)%(FileName)%(Extension)')" Outputs="@(EffectFiles->'%(RecursiveDir)%(FileName).fxc')">
		<Exec Command="@(EffectFiles->'echo ----- Compiling effect: %(RecursiveDir)%(FileName)%(Extension) ----- &amp;&amp; &quot;$(FxcCompilerPath)&quot; &quot;%(RecursiveDir)%(FileName)%(Extension)&quot; /T fx_2_0 /nologo /Fo &quot;%(RecursiveDir)%(FileName).fxc&quot; &#xA;&#xD;')" IgnoreExitCode="true" />
	</Target>
</Project>